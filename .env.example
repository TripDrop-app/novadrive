DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing — generate once, same value locally and on Vercel:
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=

# Required for first deploy: creates the only way to get the first admin (no public signup)
ADMIN_USERNAME=
ADMIN_PASSWORD=
